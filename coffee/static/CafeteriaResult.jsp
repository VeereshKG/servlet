<!DOCTYPE html>
<html>
<head>
    <title>Cafeteria Result</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light p-4">

<h2 class="text-center mb-4">Cafeteria Entered Details</h2>

<div class="d-flex justify-content-center">
    <div class="card shadow-lg" style="width: 25rem;">
        <div class="card-body">

            <p><strong>Cafeteria Name : ${name}</strong></p>
            <p><strong>Location : ${location}</strong></p>
            <p><strong>Type : ${type}</strong></p>
            <p><strong>Price : ${price}</strong></p>
            <p><strong>Franchise Name : ${franchise}</strong></p>
            <p><strong>Owner Name : ${owner}</strong></p>
            <p><strong>GST No : ${gst}</strong></p>

        </div>
    </div>
</div>

</body>
</html>
