<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>CoffeeLand Output</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="p-4 bg-light">

<div class="d-flex justify-content-center">
    <div class="card shadow-lg" style="width: 22rem;">
        <div class="card-body">

            <h4 class="card-title text-center mb-3 btn btn-info w-100">CoffeeLand Details</h4>

            <p><strong>Size of Land In Acre:</strong> ${Size}</p>
            <p><strong>Total Plants:</strong> ${Plant}</p>
            <p><strong>Total Yield:</strong> ${Yeild}</p>
            <p><strong>Expenditure:</strong> ${expenditure}</p>
            <p><strong>Profit Made:</strong> ${Profit}</p>
            <p><strong>Fertilizer Used:</strong> ${fertilizer}</p>
            <p><strong>Checked:</strong> ${Check}</p>

        </div>
    </div>
</div>

</body>
</html>
